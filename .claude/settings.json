{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/block_git_write_commands.py"],
            "timeout": 10,
            "statusMessage": "Checking git safety rule"
          }
        ]
      }
    ]
  }
}
