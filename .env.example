# VIOP AI MARKET INTELLIGENCE - environment template
# Copy to .env and fill in real values. NEVER commit .env (master spec section 98).

# ---------- Application ----------
APP_ENV=development           # development | test | production
APP_VERSION=0.1.0
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json               # json | console

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ---------- Live simulation (Phase 13) ----------
# Plays stored historical datasets through the live streaming workspace. It is
# SIMULATED history, never an exchange feed. Unauthenticated, so: off by
# default, honoured only when APP_ENV is development or test, and ignored in
# production. docker-compose publishes every port on 127.0.0.1 only.
LIVE_SIMULATION_ENABLED=false
# Seconds of silence before the event stream sends a transport heartbeat (0.5-300).
LIVE_HEARTBEAT_SECONDS=15

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=viop
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=viop
# Optional full override. When set, the POSTGRES_* values above are ignored.
# DATABASE_URL=postgresql+psycopg://viop:change-me-locally@localhost:5432/viop

# ---------- Anthropic / Claude ----------
# Not used in Phase 0. No AI adapter exists yet. Leave empty until Phase 6.
# The key is held as a SecretStr and is redacted from all log output.
ANTHROPIC_API_KEY=

# ---------- Broker ----------
# There is intentionally NO broker configuration.
# Real-money execution is disabled (master spec section 120).
# Broker credentials must never be requested or stored by this application.

# ---------- Claude Vision (Phase 6) ----------
# Never commit a real key. Leave blank to disable screenshot analysis entirely.
ANTHROPIC_API_KEY=
# No safe default exists for a model identifier, so it must be set explicitly.
# Leaving it blank makes the vision adapter refuse to build rather than guess.
VISION_MODEL=
VISION_TIMEOUT_SECONDS=60
VISION_MAX_RETRIES=2
VISION_MAX_TOKENS=2048

# ---------- Claude synthesis (Phase 7) ----------
# Shares ANTHROPIC_API_KEY above - one credential per deployment.
# No safe default exists for a model identifier, so it must be set explicitly.
# Leaving it blank makes the synthesis endpoint return NOT_CONFIGURED, which is
# a system status and NOT a market opinion: it never means WAIT or NO_TRADE.
SYNTHESIS_MODEL=
SYNTHESIS_TIMEOUT_SECONDS=90
SYNTHESIS_MAX_RETRIES=2
SYNTHESIS_MAX_OUTPUT_TOKENS=4096
# The model's hard context window, in tokens. Deliberately blank: a context
# size is a provider fact that changes without notice, and this project does
# not invent one. Leaving it unset makes synthesis report NOT_CONFIGURED
# rather than budgeting against a number nobody verified.
# The whole request is budgeted, not just the input:
#   estimated input + SYNTHESIS_MAX_OUTPUT_TOKENS + safety reserve <= window
SYNTHESIS_CONTEXT_WINDOW=
SYNTHESIS_SAFETY_RESERVE_TOKENS=2000
# Optional STRICTER cap on the input alone. 0 = no extra cap. A cap may lower
# the allowance the window leaves; it can never raise it.
SYNTHESIS_MAX_PROMPT_TOKENS=0
SYNTHESIS_MAX_CONTEXT_ENTRIES=120
